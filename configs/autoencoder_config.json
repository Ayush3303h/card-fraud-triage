{
  "data_path": "data/creditcard.csv",
  "train_ratio": 0.70,
  "validation_ratio": 0.15,
  "model": {
    "input_dim": 30,
    "hidden_dims": [20, 12],
    "latent_dim": 6,
    "dropout": 0.05,
    "noise_factor": 0.02
  },
  "training": {
    "batch_size": 256,
    "epochs": 50,
    "learning_rate": 0.001,
    "weight_decay": 1e-5,
    "patience": 8,
    "random_state": 42
  },
  "fpr_targets": [0.01, 0.005, 0.001],
  "review_capacities": [50, 100, 200]
}
